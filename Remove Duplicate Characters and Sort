import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.next();
        HashSet<Character> set=new HashSet<>();
        for(int i=0 ; i<s.length() ; i++)
        {
            set.add(s.charAt(i));
        } 
      for(char ch:set)
      {
            System.out.print(ch);
            }
        }
    }
