import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int m=sc.nextInt();
        int[] nums=new int[m];
        int index=0;
        for(int i=0;i<m;i++){
            nums[i]=sc.nextInt();
        }
        for(int i=0;i<nums.length;i++){
            if(nums[i]!=0){
                nums[index++]=nums[i];
            }
        }
        while(index<nums.length)
            nums[index++]=0;
                for(int n:nums)
                  System.out.print(n+" ");
    }
}
